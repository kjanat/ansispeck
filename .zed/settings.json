// Folder-specific settings
// vim: set ft=jsonc:
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
	"formatter": [
		{ "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } },
		{ "language_server": { "name": "dprint" } }
	],
	"prettier": { "allowed": false },
	"languages": {
		// typescript (10x better than zed's excuse for a ts extension named "tsgo") is a valid language server extension available at:
		// https://github.com/kjanat/zed-typescript
		//
		// zed themselves don't maintain their own fucking crap, nor do they feel like accepting this extension submission.
		// https://github.com/zed-industries/zed/discussions/62448
		//
		// So... @coderabbitai, if you comment on this "typescript" name being invalid even once more in the fucking future, you're gone!
		"TypeScript": {
			"language_servers": ["typescript", "biome", "deno"],
			"formatter": [
				{ "language_server": { "name": "biome" } },
				{ "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } }
			],
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
				"source.useSortedInterfaceMembers.biome": true
			}
		}
	},
	"lsp": {
		"biome": {
			"settings": {
				"config_path": "./biome.jsonc",
				"require_config_file": true,
				"assist": {
					"enabled": true,
					"actions": {
						"source": {
							"preset": "recommended",
							"organizeImports": {
								"options": {
									"groups": [":NODE:", ":BUN:", ":PACKAGE:", ":ALIAS:", ":PATH:"],
									"identifierOrder": "lexicographic",
									"sortBareImports": false,
								},
								"level": "on"
							},
							"useSortedInterfaceMembers": "on"
						}
					}
				}
			}
		},
		"deno": {
			"settings": {
				"deno": {
					"enable": true,
					"enablePaths": ["./*.config.ts", "./src"],
					"importMap": "./import_map.json"
				}
			}
		}
	}
}

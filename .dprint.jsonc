{
	// git ls-remote "https://github.com/kjanat/kjanat.git" HEAD | awk '{print substr($1, 1, 8)}' | tee /dev/stderr | wl-copy -n
	"lineWidth": 120,
	"extends": "https://github.com/kjanat/kjanat/raw/ba61f5cb/configs/dprint.remote.json",
	"markdown": { "associations": ["!README.md"], "textWrap": "always", "lineWidth": 80 },
	"prettier": { "associations": ["!**/*", "!!./README.md", "./README.md"], "useTabs": false },
	"typescript": {
		"module.sortExportDeclarations": "maintain",
		"module.sortImportDeclarations": "maintain",
		"exportDeclaration.sortNamedExports": "maintain",
		"exportDeclaration.sortTypeOnlyExports": "none",
		"importDeclaration.sortNamedImports": "maintain",
		"importDeclaration.sortTypeOnlyImports": "none",
	},
	"plugins": [
		"npm:@dprint/prettier@0.70.0/plugin.json@97c0dccf54ed5b7343e7a3f6418e77bd80afcd2b74beed3a632689d47e392ddc",
	],
}

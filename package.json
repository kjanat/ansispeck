{
	"name": "ansispeck",
	"version": "0.0.0",
	"description": "ANSI that slips in and gets to work.",
	"keywords": [
		"ansispeck",
		"terminal",
		"colors",
		"ansi",
		"formatting",
		"cli",
		"console",
		"hyperlinks",
		"osc8",
		"no-hyperlinks",
		"dreamcli"
	],
	"repository": "kjanat/ansispeck",
	"license": "0BSD",
	"author": "Kaj Kowalski <info@kajkowalski.nl> (https://github.com/kjanat)",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#ansispeck": "./src/index.ts",
		"#ansispeck/*": "./src/*.ts",
		"#ansispeck-dist": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"#ansispeck-dist/*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"#internal/*.ts": "./src/internal/*.ts",
		"#pkg": "./package.json"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./auto": {
			"types": "./dist/auto.d.ts",
			"default": "./dist/auto.js"
		},
		"./noop": {
			"types": "./dist/noop.d.ts",
			"default": "./dist/noop.js"
		},
		"./raw": {
			"types": "./dist/raw.d.ts",
			"default": "./dist/raw.js"
		},
		"./rope": {
			"types": "./dist/rope.d.ts",
			"default": "./dist/rope.js"
		},
		"./safe": {
			"types": "./dist/safe.d.ts",
			"default": "./dist/safe.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"/dist",
		"/CHANGELOG.md",
		"/LICENSE",
		"/README.md",
		"/jsr.json",
		"/package.json"
	],
	"workspaces": [
		"./.github/actions/*",
		"./benchmarks"
	],
	"scripts": {
		"bd": "run -q build",
		"bench": "run -s bench:bun bench:node",
		"bench:bun": "bunx --bun bench",
		"bench:node": "npx bench",
		"build": "bun --bun tsdown",
		"build:quiet": "bun --bun tsdown -l error",
		"deno:check": "deno check src/",
		"deno:doc": "deno doc --import-map import_map.json --no-npm --name=\"$(jq -r '.exports | .[]? // .' jsr.json)\"",
		"deno:doc:html": "run -q deno:doc --html --private --strip-trailing-html --output=./.denodocs/ $(jq -r '.exports | .[]? // .' jsr.json) 2>/dev/null",
		"deno:doc:json": "mkdir -p .denodocs; run deno:doc --json $(jq -r '.exports | .[]? // .' jsr.json) 2>/dev/null > .denodocs/documentation.json",
		"deno:doc:lint": "run deno:doc --lint $(jq -r '.exports[]' jsr.json)",
		"deno:lint": "deno lint src/",
		"dev": "run build --watch",
		"fmt": "dprint fmt",
		"lint": "biome check src/",
		"prepare": "bun ./importmapify.config.ts",
		"prepublishOnly": "run -p test typecheck",
		"tar": "run -sKq build:quiet ./scripts/pack.ts",
		"test": "bun test",
		"typecheck": "bunx @typescript/native --noEmit"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"ansi-colors": "catalog:bench",
		"benchmarks": "workspace:*",
		"biome": "catalog:",
		"chalk": "catalog:bench",
		"colorette": "catalog:bench",
		"dprint": "^0",
		"dreamcli": "npm:@kjanat/dreamcli@^3",
		"importmapify": "^1",
		"kleur": "catalog:bench",
		"mitata": "catalog:bench",
		"picocolors": "catalog:bench",
		"publint": "^0.3",
		"runner-run": "^0",
		"rust-just": "^1",
		"sort-package-json": "^4",
		"tsdown": "^0.22",
		"typescript": "<7"
	},
	"packageManager": "bun@1.4.0",
	"volta": {
		"node": "26.7.0",
		"npm": "11.19.0"
	},
	"catalog": {
		"@typescript/native": "npm:typescript@^7",
		"@actions/github-script": "github:actions/github-script",
		"@types/bun": "^1.4",
		"@types/node": ">=24",
		"biome": "npm:@biomejs/biome@^2.5",
		"typescript": "^7"
	},
	"catalogs": {
		"bench": {
			"ansi-colors": "^4",
			"chalk": "^5",
			"colorette": "^2",
			"kleur": "^4.1.5",
			"mitata": "^1",
			"picocolors": "^1"
		}
	}
}
